{
  "name": "cesium-use",
  "type": "module",
  "version": "0.16.1",
  "private": false,
  "packageManager": "pnpm@9.14.1",
  "description": "Vue powered CesiumJS utility library",
  "author": "s3xybun",
  "license": "MIT",
  "homepage": "https://github.com/s3xybun/cesium-use",
  "repository": {
    "type": "git",
    "url": "https://github.com/s3xybun/cesium-use.git"
  },
  "bugs": "https://github.com/s3xybun/cesium-use/issues",
  "keywords": [
    "cesium",
    "vue",
    "utils"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./imports": {
      "types": "./dist/imports.d.ts",
      "default": "./dist/imports.mjs"
    },
    "./resolvers": {
      "types": "./dist/resolvers.d.ts",
      "default": "./dist/resolvers.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:once": "vitest run",
    "build": "run-p type:check \"build:only {@}\" --",
    "build:types": "tsc --emitDeclarationOnly",
    "release": "pnpm type:check && bumpp",
    "build:only": "vite build",
    "type:check": "vue-tsc --noEmit --allowImportingTsExtensions && tsc --noEmit",
    "docs:dev": "vitepress dev src",
    "docs:build": "vitepress build src",
    "docs:preview": "vitepress preview src",
    "publish:ci": "npm publish --access public",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "cesium": "^1.100.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@vueuse/core": "^11.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@tsconfig/node20": "^20.1.11",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@unocss/reset": "^66.13.0",
    "@unocss/transformer-directives": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "bumpp": "^12.3.0",
    "cesium": "^1.147.0",
    "consola": "^3.4.2",
    "eslint": "^10.15.0",
    "fs-extra": "^11.4.1",
    "jsdom": "^31.0.1",
    "markdown-it-mathjax3": "^4.3.2",
    "npm-run-all2": "^9.0.4",
    "pathe": "^2.0.3",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "unocss": "^66.13.0",
    "unplugin-export-collector": "^0.6.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-static-copy": "^3.4.0",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "9"
      }
    }
  }
}
